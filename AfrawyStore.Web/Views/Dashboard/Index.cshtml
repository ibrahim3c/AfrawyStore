@{
    ViewData["Title"] = "لوحة التحكم";
}

<!-- Summary Cards Row -->
<div class="row g-4 mb-4">
    <!-- Card 1 -->
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="af-card d-flex gap-3">
            <div class="summary-icon-box" style="background-color: var(--color-primary-light); color: white;">
                <i class="bi bi-tag-fill"></i>
            </div>
            <div>
                <div class="text-mute fs-sm fw-semibold mb-1">إجمالي المنتجات</div>
                <div class="fs-4 fw-bold numeric">248</div>
                <div class="fs-caption text-success mt-1"><i class="bi bi-arrow-up-short"></i> +3 هذا الأسبوع</div>
            </div>
        </div>
    </div>
    <!-- Card 2 -->
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="af-card d-flex gap-3">
            <div class="summary-icon-box" style="background-color: var(--color-primary-light); color: white;">
                <i class="bi bi-folder-fill"></i>
            </div>
            <div>
                <div class="text-mute fs-sm fw-semibold mb-1">إجمالي الفئات</div>
                <div class="fs-4 fw-bold numeric">12</div>
                <div class="fs-caption text-secondary mt-1">منتظمة</div>
            </div>
        </div>
    </div>
    <!-- Card 3 -->
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="af-card d-flex gap-3">
            <div class="summary-icon-box" style="background-color: var(--color-accent-soft); color: var(--color-accent);">
                <i class="bi bi-cash-stack"></i>
            </div>
            <div>
                <div class="text-mute fs-sm fw-semibold mb-1">مبيعات اليوم</div>
                <div class="fs-4 fw-bold numeric text-primary">1,450.00 ج</div>
                <div class="fs-caption text-success mt-1"><i class="bi bi-arrow-up-short"></i> +15% عن الأمس</div>
            </div>
        </div>
    </div>
    <!-- Card 4 -->
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="af-card d-flex gap-3" style="border-right: 4px solid var(--status-danger);">
            <div class="summary-icon-box" style="background-color: var(--status-danger-bg); color: var(--status-danger);">
                <i class="bi bi-exclamation-triangle-fill"></i>
            </div>
            <div>
                <div class="text-mute fs-sm fw-semibold mb-1">منتجات منخفضة</div>
                <div class="fs-4 fw-bold numeric text-danger">7</div>
                <div class="fs-caption text-danger mt-1">تتطلب إعادة طلب</div>
            </div>
        </div>
    </div>
</div>

<!-- Chart & Latest Transactions Row -->
<div class="row g-4 mb-4">
    <!-- Sales Chart -->
    <div class="col-12 col-xl-8">
        <div class="af-card h-100">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h2 class="h5 fw-bold mb-0">مبيعات آخر 7 أيام</h2>
                <div class="btn-group">
                    <button class="btn btn-sm btn-outline-secondary active">7 أيام</button>
                    <button class="btn btn-sm btn-outline-secondary">30 يوم</button>
                </div>
            </div>
            <div style="height: 300px; width: 100%;">
                <canvas id="salesChart"></canvas>
            </div>
        </div>
    </div>

    <!-- Alert Panel / Low Stock -->
    <div class="col-12 col-xl-4">
        <div class="af-card h-100 p-0 overflow-hidden" style="border-top: 4px solid var(--status-danger);">
            <div class="p-4 border-bottom bg-light">
                <h2 class="h5 fw-bold mb-0 text-danger"><i class="bi bi-exclamation-circle me-2"></i>تنبيه المخزون المنخفض</h2>
            </div>
            <div class="p-0">
                <ul class="list-group list-group-flush">
                    <li class="list-group-item d-flex justify-content-between align-items-center p-3">
                        <div>
                            <div class="fw-semibold">مفتاح ربط 14mm</div>
                            <div class="fs-caption text-muted">الحد الأدنى: 5</div>
                        </div>
                        <span class="badge rounded-pill bg-danger">2 متوفر</span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between align-items-center p-3">
                        <div>
                            <div class="fw-semibold">دهان زيتي أحمر</div>
                            <div class="fs-caption text-muted">الحد الأدنى: 10</div>
                        </div>
                        <span class="badge rounded-pill bg-danger">5 متوفر</span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between align-items-center p-3">
                        <div>
                            <div class="fw-semibold">طقم مفكات 6 قطع</div>
                            <div class="fs-caption text-muted">الحد الأدنى: 3</div>
                        </div>
                        <span class="badge rounded-pill bg-warning text-dark">3 متوفر</span>
                    </li>
                </ul>
            </div>
            <div class="p-3 bg-light text-center">
                <a href="/Inventory" class="btn btn-sm btn-secondary-af w-100">عرض كل المخزون</a>
            </div>
        </div>
    </div>
</div>

<!-- Latest Transactions Table -->
<div class="af-card p-0 mb-5">
    <div class="p-4 border-bottom d-flex justify-content-between align-items-center">
        <h2 class="h5 fw-bold mb-0">أحدث العمليات</h2>
        <a href="/Sales" class="btn btn-sm btn-primary-af">عرض المبيعات</a>
    </div>
    <div class="table-responsive af-table-container border-0 rounded-0">
        <table class="table af-table text-nowrap">
            <thead>
                <tr>
                    <th>رقم البيع</th>
                    <th>التاريخ</th>
                    <th>العناصر</th>
                    <th>الإجمالي</th>
                    <th>طريقة الدفع</th>
                    <th>الحالة</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td><span class="fw-semibold numeric">#SA-8042</span></td>
                    <td class="text-muted"><i class="bi bi-clock me-1 d-inline-block"></i> منذ 10 دقائق</td>
                    <td class="numeric">3</td>
                    <td class="fw-bold numeric">255.00 ج</td>
                    <td><span class="badge bg-light text-dark border">نقدي</span></td>
                    <td><span class="status-pill good">✓ مكتمل</span></td>
                    <td class="text-end">
                        <button class="btn-icon rounded"><i class="bi bi-printer"></i></button>
                    </td>
                </tr>
                <tr>
                    <td><span class="fw-semibold numeric">#SA-8041</span></td>
                    <td class="text-muted"><i class="bi bi-clock me-1 d-inline-block"></i> منذ 45 دقيقة</td>
                    <td class="numeric">1</td>
                    <td class="fw-bold numeric">45.50 ج</td>
                    <td><span class="badge bg-light text-dark border"><i class="bi bi-credit-card me-1"></i>بطاقة</span></td>
                    <td><span class="status-pill good">✓ مكتمل</span></td>
                    <td class="text-end">
                        <button class="btn-icon rounded"><i class="bi bi-printer"></i></button>
                    </td>
                </tr>
                <tr>
                    <td><span class="fw-semibold numeric">#SA-8040</span></td>
                    <td class="text-muted"><i class="bi bi-calendar me-1 d-inline-block"></i> اليوم 08:30 ص</td>
                    <td class="numeric">12</td>
                    <td class="fw-bold numeric">1,240.00 ج</td>
                    <td><span class="badge bg-light text-dark border">نقدي</span></td>
                    <td><span class="status-pill danger">✕ ملغي</span></td>
                    <td class="text-end">
                        <button class="btn-icon rounded"><i class="bi bi-printer"></i></button>
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const ctx = document.getElementById('salesChart').getContext('2d');
            
            // Gradient fill setup
            const gradient = ctx.createLinearGradient(0, 0, 0, 300);
            gradient.addColorStop(0, '#1A3C5E');
            gradient.addColorStop(1, '#2C5F8A');
            
            new Chart(ctx, {
                type: 'bar',
                data: {
                    labels: ['الجمعة', 'السبت', 'الأحد', 'الإثنين', 'الثلاثاء', 'الأربعاء', 'الخميس'],
                    datasets: [{
                        label: 'المبيعات (ج.م)',
                        data: [800, 1500, 1200, 1600, 1900, 2100, 1450],
                        backgroundColor: gradient,
                        borderRadius: 6,
                        borderSkipped: false,
                        barPercentage: 0.6
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    animation: {
                        duration: 800,
                        easing: 'easeOutQuart'
                    },
                    plugins: {
                        legend: { display: false },
                        tooltip: {
                            backgroundColor: '#1E1E1E',
                            titleFont: { family: 'Cairo', size: 14 },
                            bodyFont: { family: 'Cairo', size: 13, weight: 'bold' },
                            padding: 12,
                            displayColors: false,
                            callbacks: {
                                label: function(context) {
                                    return context.parsed.y + ' ج.م';
                                }
                            }
                        }
                    },
                    scales: {
                        y: {
                            beginAtZero: true,
                            grid: { color: '#D4CFC8', drawBorder: false, borderDash: [5, 5] },
                            ticks: {
                                font: { family: 'Cairo' },
                                color: '#6B6560'
                            }
                        },
                        x: {
                            grid: { display: false, drawBorder: false },
                            ticks: {
                                font: { family: 'Cairo', weight: '600' },
                                color: '#6B6560'
                            }
                        }
                    }
                }
            });
        });
    </script>
}
