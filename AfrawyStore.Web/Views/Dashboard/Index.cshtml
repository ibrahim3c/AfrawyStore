@using AfrawyStore.Application.DTOs
@using AfrawyStore.Domain.Enums
@model DashboardViewModel
@{
    ViewData["Title"] = "لوحة التحكم";
}

<!-- Summary Cards Row -->
<div class="row g-4 mb-4">
    <!-- Card 1: Total Products -->
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="af-card d-flex gap-3">
            <div class="summary-icon-box" style="background-color: var(--color-primary-light); color: white;">
                <i class="bi bi-tag-fill"></i>
            </div>
            <div>
                <div class="text-mute fs-sm fw-semibold mb-1">إجمالي المنتجات</div>
                <div class="fs-4 fw-bold numeric">@Model.TotalProducts</div>
                <div class="fs-caption text-muted mt-1">منتج نشط</div>
            </div>
        </div>
    </div>
    <!-- Card 2: Total Categories -->
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="af-card d-flex gap-3">
            <div class="summary-icon-box" style="background-color: var(--color-primary-light); color: white;">
                <i class="bi bi-folder-fill"></i>
            </div>
            <div>
                <div class="text-mute fs-sm fw-semibold mb-1">إجمالي الفئات</div>
                <div class="fs-4 fw-bold numeric">@Model.TotalCategories</div>
                <div class="fs-caption text-secondary mt-1">فئة مسجلة</div>
            </div>
        </div>
    </div>
    <!-- Card 3: Today's Sales -->
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="af-card d-flex gap-3">
            <div class="summary-icon-box" style="background-color: var(--color-accent-soft); color: var(--color-accent);">
                <i class="bi bi-cash-stack"></i>
            </div>
            <div>
                <div class="text-mute fs-sm fw-semibold mb-1">مبيعات اليوم</div>
                <div class="fs-4 fw-bold numeric text-primary">@Model.TodaySales.ToString("N2") ج</div>
                <div class="fs-caption text-success mt-1">@Model.TodaySalesCount عملية اليوم</div>
            </div>
        </div>
    </div>
    <!-- Card 4: Low Stock Alerts -->
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="af-card d-flex gap-3" style="border-right: 4px solid var(--status-danger);">
            <div class="summary-icon-box" style="background-color: var(--status-danger-bg); color: var(--status-danger);">
                <i class="bi bi-exclamation-triangle-fill"></i>
            </div>
            <div>
                <div class="text-mute fs-sm fw-semibold mb-1">منتجات منخفضة</div>
                <div class="fs-4 fw-bold numeric text-danger">@Model.LowStockCount</div>
                <div class="fs-caption text-danger mt-1">تتطلب إعادة طلب</div>
            </div>
        </div>
    </div>
</div>

<!-- Chart & Latest Transactions Row -->
<div class="row g-4 mb-4">
    <!-- Sales Chart -->
    <div class="col-12 col-xl-8">
        <div class="af-card h-100">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h2 class="h5 fw-bold mb-0">مبيعات آخر 7 أيام</h2>
                <div class="btn-group">
                    <button class="btn btn-sm btn-outline-secondary active">7 أيام</button>
                    <button class="btn btn-sm btn-outline-secondary">30 يوم</button>
                </div>
            </div>
            <div style="height: 300px; width: 100%;">
                <canvas id="salesChart"></canvas>
            </div>
        </div>
    </div>

    <!-- Alert Panel / Low Stock -->
    <div class="col-12 col-xl-4">
        <div class="af-card h-100 p-0 overflow-hidden" style="border-top: 4px solid var(--status-danger);">
            <div class="p-4 border-bottom bg-light">
                <h2 class="h5 fw-bold mb-0 text-danger"><i class="bi bi-exclamation-circle me-2"></i>تنبيه المخزون المنخفض</h2>
            </div>
            <div class="p-0">
                <ul class="list-group list-group-flush">
                    @if (Model.LowStockItems.Any())
                    {
                        @foreach (var item in Model.LowStockItems)
                        {
                            <li class="list-group-item d-flex justify-content-between align-items-center p-3">
                                <div style="max-width: 70%;">
                                    <div class="fw-semibold text-truncate">@item.ProductName</div>
                                    <div class="fs-caption text-muted">الحد الأدنى: @item.MinimumStock @item.Unit</div>
                                </div>
                                <span class="badge rounded-pill @(item.CurrentStock == 0 ? "bg-danger" : "bg-warning text-dark")">
                                    @item.CurrentStock متوفر
                                </span>
                            </li>
                        }
                    }
                    else
                    {
                        <li class="list-group-item p-4 text-center text-muted">
                            <i class="bi bi-check-circle text-success fs-3 d-block mb-2"></i>
                            لا توجد تنبيهات حالياً
                        </li>
                    }
                </ul>
            </div>
            <div class="p-3 bg-light text-center">
                <a href="/Inventory" class="btn btn-sm btn-secondary-af w-100">عرض كل المخزون</a>
            </div>
        </div>
    </div>
</div>

<!-- Latest Transactions Table -->
<div class="af-card p-0 mb-5">
    <div class="p-4 border-bottom d-flex justify-content-between align-items-center">
        <h2 class="h5 fw-bold mb-0">أحدث العمليات</h2>
        <a href="/Sales" class="btn btn-sm btn-primary-af">عرض المبيعات</a>
    </div>
    <div class="table-responsive af-table-container border-0 rounded-0">
        <table class="table af-table text-nowrap">
            <thead>
                <tr>
                    <th>رقم البيع</th>
                    <th>التاريخ</th>
                    <th>العناصر</th>
                    <th>الإجمالي</th>
                    <th>طريقة الدفع</th>
                    <th>الحالة</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (Model.LatestSales.Any())
                {
                    @foreach (var sale in Model.LatestSales)
                    {
                        <tr>
                            <td><span class="fw-semibold numeric">#SA-@sale.Id.ToString("D4")</span></td>
                            <td class="text-muted">
                                <i class="bi bi-calendar me-1 d-inline-block"></i> @sale.SaleDate.ToString("yyyy/MM/dd HH:mm")
                            </td>
                            <td class="numeric">@sale.ItemCount</td>
                            <td class="fw-bold numeric">@sale.TotalAmount.ToString("N2") ج</td>
                            <td><span class="badge bg-light text-dark border">@sale.PaymentMethodLabel</span></td>
                            <td>
                                @if (sale.Status == SaleStatus.Completed)
                                {
                                    <span class="status-pill good">✓ @sale.StatusLabel</span>
                                }
                                else
                                {
                                    <span class="status-pill danger">✕ @sale.StatusLabel</span>
                                }
                            </td>
                            <td class="text-end">
                                <a href="/Sales/Detail/@sale.Id" class="btn-icon rounded"><i class="bi bi-eye"></i></a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7" class="text-center p-5 text-muted">
                            لا توجد عمليات بيع مسجلة بعد
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const ctx = document.getElementById('salesChart').getContext('2d');
            
            // Gradient fill setup
            const gradient = ctx.createLinearGradient(0, 0, 0, 300);
            gradient.addColorStop(0, '#1A3C5E');
            gradient.addColorStop(1, '#2C5F8A');
            
            new Chart(ctx, {
                type: 'bar',
                data: {
                    labels: @Html.Raw(Json.Serialize(Model.Last7DaysSales.Select(s => s.DayLabel))),
                    datasets: [{
                        label: 'المبيعات (ج.م)',
                        data: @Html.Raw(Json.Serialize(Model.Last7DaysSales.Select(s => s.Total))),
                        backgroundColor: gradient,
                        borderRadius: 6,
                        borderSkipped: false,
                        barPercentage: 0.6
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    animation: {
                        duration: 800,
                        easing: 'easeOutQuart'
                    },
                    plugins: {
                        legend: { display: false },
                        tooltip: {
                            backgroundColor: '#1E1E1E',
                            titleFont: { family: 'Cairo', size: 14 },
                            bodyFont: { family: 'Cairo', size: 13, weight: 'bold' },
                            padding: 12,
                            displayColors: false,
                            callbacks: {
                                label: function(context) {
                                    return context.parsed.y + ' ج.م';
                                }
                            }
                        }
                    },
                    scales: {
                        y: {
                            beginAtZero: true,
                            grid: { color: '#D4CFC8', drawBorder: false, borderDash: [5, 5] },
                            ticks: {
                                font: { family: 'Cairo' },
                                color: '#6B6560'
                            }
                        },
                        x: {
                            grid: { display: false, drawBorder: false },
                            ticks: {
                                font: { family: 'Cairo', weight: '600' },
                                color: '#6B6560'
                            }
                        }
                    }
                }
            });
        });
    </script>
}
