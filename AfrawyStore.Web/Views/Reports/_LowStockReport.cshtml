@model IEnumerable<AfrawyStore.Application.DTOs.LowStockReportDto>
@{
    var rows    = Model.ToList();
    var outCnt  = rows.Count(r => r.Status == "out");
    var lowCnt  = rows.Count(r => r.Status == "low");
}

<div class="row g-3 mb-4">
    <div class="col-md-4 col-sm-6">
        <div class="card shadow-sm border-0 rounded-4 border-start border-4 border-danger">
            <div class="card-body d-flex align-items-center gap-3 py-3">
                <div class="rounded-circle bg-danger bg-opacity-10 text-danger d-flex align-items-center justify-content-center" style="width:48px;height:48px;">
                    <i class="bi bi-x-octagon fs-4"></i>
                </div>
                <div>
                    <div class="text-muted small">نفد من المخزون</div>
                    <div class="h4 mb-0 fw-bold text-danger">@outCnt</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4 col-sm-6">
        <div class="card shadow-sm border-0 rounded-4 border-start border-4 border-warning">
            <div class="card-body d-flex align-items-center gap-3 py-3">
                <div class="rounded-circle bg-warning bg-opacity-10 text-warning d-flex align-items-center justify-content-center" style="width:48px;height:48px;">
                    <i class="bi bi-exclamation-triangle fs-4"></i>
                </div>
                <div>
                    <div class="text-muted small">مخزون منخفض</div>
                    <div class="h4 mb-0 fw-bold text-warning">@lowCnt</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4 col-sm-6">
        <div class="card shadow-sm border-0 rounded-4 border-start border-4 border-secondary">
            <div class="card-body d-flex align-items-center gap-3 py-3">
                <div class="rounded-circle bg-secondary bg-opacity-10 text-secondary d-flex align-items-center justify-content-center" style="width:48px;height:48px;">
                    <i class="bi bi-list-check fs-4"></i>
                </div>
                <div>
                    <div class="text-muted small">إجمالي التنبيهات</div>
                    <div class="h4 mb-0 fw-bold">@rows.Count</div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="card shadow-sm border-0 rounded-4">
    <div class="card-header bg-transparent border-0 pt-4 px-4 d-flex align-items-center gap-2">
        <i class="bi bi-exclamation-triangle-fill text-warning"></i>
        <h6 class="fw-semibold mb-0">المنتجات التي تحتاج إعادة تخزين</h6>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">SKU</th>
                        <th>المنتج</th>
                        <th>الفئة</th>
                        <th class="text-center">الوحدة</th>
                        <th class="text-center">المخزون الحالي</th>
                        <th class="text-center">الحد الأدنى</th>
                        <th class="text-center">العجز</th>
                        <th class="text-center pe-4">الحالة</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in rows)
                    {
                        var rc = item.Status == "out" ? "table-danger" : "table-warning";
                        <tr class="@rc">
                            <td class="ps-4"><span class="badge bg-light text-dark border font-monospace">@item.SKU</span></td>
                            <td class="fw-semibold text-dark">@item.ProductName</td>
                            <td class="text-muted small">@item.CategoryName</td>
                            <td class="text-center text-muted small">@item.Unit</td>
                            <td class="text-center fw-bold @(item.Status == "out" ? "text-danger" : "text-warning")">
                                @item.CurrentStock.ToString("F2")
                            </td>
                            <td class="text-center text-muted">@item.MinimumStock.ToString("F2")</td>
                            <td class="text-center fw-bold text-dark">
                                @item.Deficit.ToString("F2")
                            </td>
                            <td class="text-center pe-4">
                                @if (item.Status == "out")
                                {
                                    <span class="badge bg-danger bg-opacity-10 text-danger border border-danger-subtle px-2 py-1">
                                        <i class="bi bi-x-octagon-fill me-1"></i>نفد
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-warning bg-opacity-10 text-warning border border-warning-subtle px-2 py-1">
                                        <i class="bi bi-exclamation-triangle-fill me-1"></i>منخفض
                                    </span>
                                }
                            </td>
                        </tr>
                    }
                    @if (!rows.Any())
                    {
                        <tr>
                            <td colspan="8" class="text-center py-5 text-muted">
                                <i class="bi bi-check-circle fs-2 d-block mb-2 text-success"></i>
                                جميع المنتجات فوق الحد الأدنى للمخزون
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
