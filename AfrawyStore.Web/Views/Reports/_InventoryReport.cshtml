@model IEnumerable<AfrawyStore.Application.DTOs.InventoryReportDto>
@{
    var rows     = Model.ToList();
    var okCnt    = rows.Count(r => r.StockStatus == "ok");
    var lowCnt   = rows.Count(r => r.StockStatus == "low");
    var outCnt   = rows.Count(r => r.StockStatus == "out");
    var totalVal = rows.Sum(r => r.StockValue);
}

<div class="row g-3 mb-4">
    <div class="col-md-3 col-sm-6">
        <div class="card shadow-sm border-0 rounded-4 border-start border-4 border-success">
            <div class="card-body d-flex align-items-center gap-3 py-3">
                <div class="rounded-circle bg-success bg-opacity-10 text-success d-flex align-items-center justify-content-center" style="width:48px;height:48px;">
                    <i class="bi bi-check-circle fs-4"></i>
                </div>
                <div>
                    <div class="text-muted small">متوفر</div>
                    <div class="h4 mb-0 fw-bold text-success">@okCnt</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3 col-sm-6">
        <div class="card shadow-sm border-0 rounded-4 border-start border-4 border-warning">
            <div class="card-body d-flex align-items-center gap-3 py-3">
                <div class="rounded-circle bg-warning bg-opacity-10 text-warning d-flex align-items-center justify-content-center" style="width:48px;height:48px;">
                    <i class="bi bi-exclamation-triangle fs-4"></i>
                </div>
                <div>
                    <div class="text-muted small">منخفض</div>
                    <div class="h4 mb-0 fw-bold text-warning">@lowCnt</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3 col-sm-6">
        <div class="card shadow-sm border-0 rounded-4 border-start border-4 border-danger">
            <div class="card-body d-flex align-items-center gap-3 py-3">
                <div class="rounded-circle bg-danger bg-opacity-10 text-danger d-flex align-items-center justify-content-center" style="width:48px;height:48px;">
                    <i class="bi bi-x-octagon fs-4"></i>
                </div>
                <div>
                    <div class="text-muted small">نفد</div>
                    <div class="h4 mb-0 fw-bold text-danger">@outCnt</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3 col-sm-6">
        <div class="card shadow-sm border-0 rounded-4 border-start border-4 border-info">
            <div class="card-body d-flex align-items-center gap-3 py-3">
                <div class="rounded-circle bg-info bg-opacity-10 text-info d-flex align-items-center justify-content-center" style="width:48px;height:48px;">
                    <i class="bi bi-bank2 fs-4"></i>
                </div>
                <div>
                    <div class="text-muted small">قيمة المخزون (تكلفة)</div>
                    <div class="h4 mb-0 fw-bold text-info">@totalVal.ToString("F2") ج.م</div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="card shadow-sm border-0 rounded-4">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">SKU</th>
                        <th>المنتج</th>
                        <th>الفئة</th>
                        <th class="text-center">الوحدة</th>
                        <th class="text-center">الحالي</th>
                        <th class="text-center">الأدنى</th>
                        <th class="text-center">قيمة المخزون</th>
                        <th class="text-center pe-4">الحالة</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in rows)
                    {
                        var rc = item.StockStatus == "out" ? "table-danger" : item.StockStatus == "low" ? "table-warning" : "";
                        <tr class="@rc">
                            <td class="ps-4"><span class="badge bg-light text-dark border font-monospace">@item.SKU</span></td>
                            <td class="fw-semibold text-dark">@item.ProductName</td>
                            <td class="text-muted small">@item.CategoryName</td>
                            <td class="text-center text-muted small">@item.Unit</td>
                            <td class="text-center fw-bold @(item.StockStatus == "out" ? "text-danger" : item.StockStatus == "low" ? "text-warning" : "text-success")">
                                @item.CurrentStock.ToString("F2")
                            </td>
                            <td class="text-center text-muted">@item.MinimumStock.ToString("F2")</td>
                            <td class="text-center">@item.StockValue.ToString("F2") ج.م</td>
                            <td class="text-center pe-4">
                                @if (item.StockStatus == "out")
                                {
                                    <span class="badge bg-danger bg-opacity-10 text-danger border border-danger-subtle px-2 py-1">
                                        <i class="bi bi-x-octagon-fill me-1"></i>نفد
                                    </span>
                                }
                                else if (item.StockStatus == "low")
                                {
                                    <span class="badge bg-warning bg-opacity-10 text-warning border border-warning-subtle px-2 py-1">
                                        <i class="bi bi-exclamation-triangle-fill me-1"></i>منخفض
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-success bg-opacity-10 text-success border border-success-subtle px-2 py-1">
                                        <i class="bi bi-check-circle-fill me-1"></i>متوفر
                                    </span>
                                }
                            </td>
                        </tr>
                    }
                    @if (!rows.Any())
                    {
                        <tr>
                            <td colspan="8" class="text-center py-5 text-muted">
                                <i class="bi bi-inbox fs-2 d-block mb-2 text-black-50"></i>
                                لا توجد بيانات مخزون
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
