@model AfrawyStore.Application.DTOs.SalesReportDto

<!-- Summary Cards -->
<div class="row g-3 mb-4">
    <div class="col-md-3 col-sm-6">
        <div class="card shadow-sm border-0 rounded-4 border-start border-4 border-primary">
            <div class="card-body d-flex align-items-center gap-3 py-3">
                <div class="rounded-circle bg-primary bg-opacity-10 text-primary d-flex align-items-center justify-content-center" style="width:48px;height:48px;">
                    <i class="bi bi-receipt fs-4"></i>
                </div>
                <div>
                    <div class="text-muted small">إجمالي العمليات</div>
                    <div class="h4 mb-0 fw-bold text-primary">@Model.TotalSalesCount</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3 col-sm-6">
        <div class="card shadow-sm border-0 rounded-4 border-start border-4 border-success">
            <div class="card-body d-flex align-items-center gap-3 py-3">
                <div class="rounded-circle bg-success bg-opacity-10 text-success d-flex align-items-center justify-content-center" style="width:48px;height:48px;">
                    <i class="bi bi-currency-dollar fs-4"></i>
                </div>
                <div>
                    <div class="text-muted small">إجمالي الإيرادات</div>
                    <div class="h4 mb-0 fw-bold text-success">@Model.TotalRevenue.ToString("F2") ج.م</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3 col-sm-6">
        <div class="card shadow-sm border-0 rounded-4 border-start border-4 border-info">
            <div class="card-body d-flex align-items-center gap-3 py-3">
                <div class="rounded-circle bg-info bg-opacity-10 text-info d-flex align-items-center justify-content-center" style="width:48px;height:48px;">
                    <i class="bi bi-graph-up-arrow fs-4"></i>
                </div>
                <div>
                    <div class="text-muted small">إجمالي الربح</div>
                    <div class="h4 mb-0 fw-bold text-info">@Model.TotalProfit.ToString("F2") ج.م</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3 col-sm-6">
        <div class="card shadow-sm border-0 rounded-4 border-start border-4 border-warning">
            <div class="card-body d-flex align-items-center gap-3 py-3">
                <div class="rounded-circle bg-warning bg-opacity-10 text-warning d-flex align-items-center justify-content-center" style="width:48px;height:48px;">
                    <i class="bi bi-percent fs-4"></i>
                </div>
                <div>
                    <div class="text-muted small">هامش الربح</div>
                    <div class="h4 mb-0 fw-bold text-warning">@Model.ProfitMarginPercent%</div>
                </div>
            </div>
        </div>
    </div>
</div>



<!-- Daily Breakdown Table -->
<div class="card shadow-sm border-0 rounded-4">
    <div class="card-header bg-transparent border-0 pt-4 px-4">
        <h6 class="fw-semibold mb-0"><i class="bi bi-table me-1"></i>التفاصيل اليومية</h6>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">التاريخ</th>
                        <th class="text-center">عدد العمليات</th>
                        <th class="text-center">الإيرادات</th>
                        <th class="text-center">الربح</th>
                        <th class="text-center pe-4">الخصم</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in Model.DailyRows)
                    {
                        <tr class="@(row.SaleCount == 0 ? "text-muted" : "")">
                            <td class="ps-4 fw-semibold">@row.DateLabel</td>
                            <td class="text-center">
                                @if (row.SaleCount > 0)
                                {
                                    <span class="badge bg-primary bg-opacity-10 text-primary border border-primary-subtle px-2 py-1">@row.SaleCount</span>
                                }
                                else
                                {
                                    <span class="text-black-50">—</span>
                                }
                            </td>
                            <td class="text-center fw-semibold @(row.Revenue > 0 ? "text-success" : "text-black-50")">
                                @(row.Revenue > 0 ? row.Revenue.ToString("F2") + " ج.م" : "—")
                            </td>
                            <td class="text-center @(row.Profit > 0 ? "text-info" : "text-black-50")">
                                @(row.Profit > 0 ? row.Profit.ToString("F2") + " ج.م" : "—")
                            </td>
                            <td class="text-center pe-4 text-muted">
                                @(row.Discount > 0 ? row.Discount.ToString("F2") + " ج.م" : "—")
                            </td>
                        </tr>
                    }
                    @if (!Model.DailyRows.Any())
                    {
                        <tr>
                            <td colspan="5" class="text-center py-5 text-muted">
                                <i class="bi bi-inbox fs-2 d-block mb-2 text-black-50"></i>
                                لا توجد مبيعات في هذه الفترة
                            </td>
                        </tr>
                    }
                </tbody>
                @if (Model.DailyRows.Any())
                {
                    <tfoot class="table-light fw-bold">
                        <tr>
                            <td class="ps-4">الإجمالي</td>
                            <td class="text-center">@Model.TotalSalesCount</td>
                            <td class="text-center text-success">@Model.TotalRevenue.ToString("F2") ج.م</td>
                            <td class="text-center text-info">@Model.TotalProfit.ToString("F2") ج.م</td>
                            <td class="text-center pe-4 text-muted">@Model.TotalDiscount.ToString("F2") ج.م</td>
                        </tr>
                    </tfoot>
                }
            </table>
        </div>
    </div>
</div>
