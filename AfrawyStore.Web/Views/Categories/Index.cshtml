@model IEnumerable<AfrawyStore.Application.DTOs.CategoryDto>
@{
    ViewData["Title"] = "إدارة الفئات";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="h3 text-primary mb-0"><i class="bi bi-tags me-2"></i> @ViewData["Title"]</h2>
    <a asp-action="Create" class="btn btn-primary-af shadow-sm">
        <i class="bi bi-plus-lg me-1"></i> إضافة فئة
    </a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
        <i class="bi bi-check-circle me-2"></i> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
        <i class="bi bi-exclamation-triangle me-2"></i> @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="card shadow-sm border-0 rounded-4">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">الرقم</th>
                        <th>اسم الفئة</th>
                        <th>الفئة الرئيسية</th>
                        <th>الوصف</th>
                        <th class="text-end pe-4">الإجراءات</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var category in Model)
                    {
                        <tr>
                            <td class="ps-4 text-muted">@category.Id</td>
                            <td class="fw-semibold text-dark">@category.Name</td>
                            <td>
                                @if (category.ParentCategoryId.HasValue)
                                {
                                    <span class="badge bg-info bg-opacity-10 text-info border border-info-subtle px-2 py-1 rounded-3">@category.ParentCategoryName</span>
                                }
                                else
                                {
                                    <span class="text-muted small">فئة رئيسية</span>
                                }
                            </td>
                            <td class="text-muted text-truncate" style="max-width: 200px;">
                                @(string.IsNullOrEmpty(category.Description) ? "—" : category.Description)
                            </td>
                            <td class="text-end pe-4">
                                <a asp-action="Edit" asp-route-id="@category.Id" class="btn btn-sm btn-outline-primary shadow-sm">
                                    <i class="bi bi-pencil"></i> تعديل
                                </a>
                                <form asp-action="Delete" asp-route-id="@category.Id" method="post" class="d-inline">
                                    <button type="submit" class="btn btn-sm btn-outline-danger shadow-sm ms-1" onclick="return confirm('هل أنت متأكد من حذف هذه الفئة؟');">
                                        <i class="bi bi-trash"></i> حذف
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="5" class="text-center py-5 text-muted">
                                <i class="bi bi-inbox fs-2 d-block mb-2 text-black-50"></i>
                                لا يوجد فئات مضافة
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
