@model AfrawyStore.Application.DTOs.ProductDto
@{
    ViewData["Title"] = "تفاصيل المنتج";
    var profitMargin = Model.SellingPrice > 0 ? ((Model.SellingPrice - Model.CostPrice) / Model.SellingPrice) * 100 : 0;
    var profitAmount = Model.SellingPrice - Model.CostPrice;
    var isLowStock = Model.CurrentStock <= Model.MinimumStock;
}

<div class="row g-4">
    <!-- ═══ Column 1: Visual Identity & Stats ═══ -->
    <div class="col-xl-4 col-lg-5">
        <!-- Main Visual Card -->
        <div class="card border-0 shadow-sm mb-4" style="border-radius:var(--radius-lg)!important; overflow:hidden;">
            <div class="p-4 text-center" style="background:var(--surface-2); border-bottom:1px solid var(--border);">
                @if (!string.IsNullOrEmpty(Model.ImagePath))
                {
                    <img src="@Model.ImagePath" alt="@Model.Name" class="img-fluid rounded-4 shadow-sm" style="max-height: 300px; object-fit: contain; background:white; padding:12px; border:1px solid var(--border-light);" />
                }
                else
                {
                    <div class="py-5 opacity-25">
                        <i class="bi bi-image" style="font-size: 6rem;"></i>
                    </div>
                }
            </div>
            <div class="card-body p-4">
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <span class="badge bg-light text-muted border px-2 py-1" style="font-family:monospace;">@Model.SKU</span>
                    @if (Model.IsActive)
                    {
                        <span class="status-pill good"><i class="bi bi-check-circle-fill"></i> نشط</span>
                    }
                    else
                    {
                        <span class="status-pill danger"><i class="bi bi-dash-circle-fill"></i> معطل</span>
                    }
                </div>
                <h3 class="fw-bold mb-1" style="color:var(--ink);">@Model.Name</h3>
                <p class="text-muted mb-0"><i class="bi bi-folder2-open me-1"></i> @Model.CategoryName</p>
            </div>
        </div>

        <!-- Inventory KPI Card -->
        <div class="card border-0 shadow-sm overflow-hidden mb-4" style="border-radius:var(--radius-lg)!important;">
            <div class="card-header bg-white py-3 px-4 d-flex align-items-center gap-2">
                <div class="summary-icon-box @(isLowStock ? "icon-danger" : "icon-success")" style="width:30px; height:30px; font-size:0.9rem; border-radius:6px;">
                    <i class="bi @(isLowStock ? "bi-exclamation-triangle-fill" : "bi-box-seam-fill")"></i>
                </div>
                <h6 class="mb-0 fw-bold">حالة المخزون</h6>
            </div>
            <div class="card-body p-4 text-center">
                <div class="display-5 fw-bold numeric @(isLowStock ? "text-danger" : "text-success")">
                    @Model.CurrentStock.ToString("G29")
                </div>
                <div class="text-muted fw-semibold mb-3">@Model.Unit</div>
                
                <div class="p-3 rounded-4" style="background:var(--surface-2); border:1px solid var(--border-light);">
                    <div class="d-flex justify-content-between align-items-center fs-sm">
                        <span class="text-muted">حد الأمان</span>
                        <span class="fw-bold text-dark">@Model.MinimumStock.ToString("G29") @Model.Unit</span>
                    </div>
                    <div class="progress mt-2" style="height: 6px; background:rgba(0,0,0,0.05);">
                        @{
                            var stockPct = Model.MinimumStock > 0 ? (Model.CurrentStock / (Model.MinimumStock * 2) * 100) : 100;
                            if (stockPct > 100) stockPct = 100;
                        }
                        <div class="progress-bar @(isLowStock ? "bg-danger" : "bg-success")" style="width: @stockPct.ToString("F0")%"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- ═══ Column 2: Detailed Specs & Financials ═══ -->
    <div class="col-xl-8 col-lg-7">
        
        <!-- Header Actions Card -->
        <div class="card border-0 shadow-sm mb-4" style="border-radius:var(--radius-lg)!important;">
            <div class="card-body p-3 d-flex flex-wrap justify-content-between align-items-center gap-3">
                <div class="d-flex align-items-center gap-2 ps-2">
                    <a asp-action="Index" class="btn btn-icon" title="عودة">
                        <i class="bi bi-arrow-right"></i>
                    </a>
                    <span class="text-muted opacity-50">/</span>
                    <span class="fw-bold text-muted fs-sm">تفاصيل المنتج</span>
                </div>
                <div class="d-flex gap-2">
                    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary-af">
                        <i class="bi bi-pencil-square me-1"></i> تعديل البيانات
                    </a>
                </div>
            </div>
        </div>

        <!-- Description Card -->
        <div class="card border-0 shadow-sm mb-4" style="border-radius:var(--radius-lg)!important;">
            <div class="card-header bg-white py-3 px-4 d-flex align-items-center gap-2">
                <div class="summary-icon-box icon-primary" style="width:30px; height:30px; font-size:0.9rem; border-radius:6px;">
                    <i class="bi bi-text-paragraph"></i>
                </div>
                <h6 class="mb-0 fw-bold">وصف المنتج والمواصفات</h6>
            </div>
            <div class="card-body p-4">
                <p class="text-dark mb-0" style="line-height: 1.9; font-size: 1.05rem; white-space: pre-line;">
                    @(string.IsNullOrEmpty(Model.Description) ? "لا يوجد وصف مسجل لهذا المنتج." : Model.Description)
                </p>
            </div>
        </div>

        <!-- Financial Analysis Matrix -->
        <div class="card border-0 shadow-sm" style="border-radius:var(--radius-lg)!important; overflow:hidden;">
            <div class="card-header bg-white py-3 px-4 d-flex align-items-center gap-2">
                <div class="summary-icon-box icon-success" style="width:30px; height:30px; font-size:0.9rem; border-radius:6px;">
                    <i class="bi bi-currency-dollar"></i>
                </div>
                <h6 class="mb-0 fw-bold">التحليل المالي والربحية</h6>
            </div>
            <div class="card-body p-0">
                <div class="row g-0">
                    <!-- Pricing Column -->
                    <div class="col-md-7 p-4 border-left" style="background:linear-gradient(to bottom right, #fff, var(--surface-2));">
                        <div class="row g-4">
                            <div class="col-sm-6">
                                <label class="fs-caption fw-bold text-muted text-uppercase mb-2 d-block">سعر التكلفة</label>
                                <div class="h3 fw-bold numeric text-dark mb-0">@Model.CostPrice.ToString("N2") <small class="fs-6 fw-normal">ج.م</small></div>
                                <div class="fs-caption text-muted mt-1">لكل @Model.Unit</div>
                            </div>
                            <div class="col-sm-6">
                                <label class="fs-caption fw-bold text-muted text-uppercase mb-2 d-block">سعر البيع</label>
                                <div class="h3 fw-bold numeric text-primary mb-0">@Model.SellingPrice.ToString("N2") <small class="fs-6 fw-normal">ج.م</small></div>
                                <div class="fs-caption text-muted mt-1">لكل @Model.Unit</div>
                            </div>
                        </div>
                        
                        <div class="mt-4 pt-4 border-top">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <span class="fs-sm fw-bold text-muted">توزيع السعر (تكلفة مقابل ربح)</span>
                                <span class="fs-sm fw-bold text-success">@(profitMargin.ToString("F1"))% ربح</span>
                            </div>
                            <div class="progress" style="height: 12px; border-radius: 6px; background:rgba(0,0,0,0.05);">
                                @{
                                    var costPct = Model.SellingPrice > 0 ? (Model.CostPrice / Model.SellingPrice * 100) : 0;
                                    var profPct = 100 - costPct;
                                }
                                <div class="progress-bar" style="width: @costPct.ToString("F0")%; background: #e2e8f0; border-radius: 6px 0 0 6px;"></div>
                                <div class="progress-bar" style="width: @profPct.ToString("F0")%; background: var(--success); border-radius: 0 6px 6px 0;"></div>
                            </div>
                        </div>
                    </div>

                    <!-- Profit Summary Column -->
                    <div class="col-md-5 p-4 d-flex flex-column justify-content-center text-center">
                        <div class="mb-2 fs-caption fw-bold text-muted text-uppercase" style="letter-spacing:0.1em;">صافي الربح للوحدة</div>
                        <div class="display-6 fw-bold numeric @(profitAmount >= 0 ? "text-success" : "text-danger")">
                            @profitAmount.ToString("N2") <small class="fs-4 fw-normal">ج.م</small>
                        </div>
                        <div class="mt-3">
                            @if (profitAmount > 0)
                            {
                                <div class="p-3 rounded-4 d-inline-block" style="background:var(--success-bg); border:1px solid rgba(16,185,129,0.1);">
                                    <div class="fw-bold text-success"><i class="bi bi-graph-up-arrow me-2"></i>ربحية جيدة</div>
                                    <div class="fs-caption text-success opacity-75">تحقق هامش @profitMargin.ToString("N1")%</div>
                                </div>
                            }
                            else
                            {
                                <div class="p-3 rounded-4 d-inline-block" style="background:var(--danger-bg); border:1px solid rgba(239,68,68,0.1);">
                                    <div class="fw-bold text-danger"><i class="bi bi-exclamation-octagon me-2"></i>تحذير خسارة</div>
                                    <div class="fs-caption text-danger opacity-75">السعر أقل من التكلفة</div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
            <div class="card-footer bg-light p-3 px-4 border-top-0">
                <div class="d-flex align-items-center gap-3 text-muted fs-caption">
                    <i class="bi bi-info-circle-fill"></i>
                    <span>يتم تحديث هذه البيانات تلقائياً عند تعديل أسعار التوريد أو البيع.</span>
                </div>
            </div>
        </div>
    </div>
</div>
