@{
    Layout = null;
    ViewData["Title"] = "تسجيل الدخول";
}
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>تسجيل الدخول - متجر الأفراوي</title>
    <!-- Bootstrap RTL -->
    <link rel="stylesheet" href="~/css/bootstrap.rtl.min.css" />
    <!-- Cairo Font -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700&display=swap" rel="stylesheet">
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <!-- Global Custom Styles -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
        body {
            background-color: var(--color-primary);
            background-image: 
                linear-gradient(rgba(26, 60, 94, 0.85), rgba(26, 60, 94, 0.95)),
                repeating-linear-gradient(45deg, transparent, transparent 40px, rgba(255,255,255,0.03) 40px, rgba(255,255,255,0.03) 80px);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .login-card {
            background: #ffffff;
            border-radius: var(--radius-xl);
            box-shadow: var(--shadow-xl);
            width: 100%;
            max-width: 440px;
            padding: var(--space-7) var(--space-5);
            position: relative;
            overflow: hidden;
            animation: slideUp 0.4s ease-out forwards;
        }

        .login-brand-icon {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 64px;
            height: 64px;
            background-color: var(--color-accent-soft);
            color: var(--color-accent);
            border-radius: 16px;
            font-size: 2rem;
            margin-bottom: var(--space-4);
            animation: scaleIn 0.5s cubic-bezier(0.175, 0.885, 0.32, 1.275) forwards;
            animation-delay: 0.2s;
            opacity: 0;
            transform: scale(0.5);
        }

        @@keyframes slideUp {
            from { opacity: 0; transform: translateY(20px); }
            to { opacity: 1; transform: translateY(0); }
        }

        @@keyframes scaleIn {
            to { opacity: 1; transform: scale(1); }
        }
        
        .input-group-text {
            background-color: transparent;
            border-left: none;
            color: var(--color-ink-muted);
        }
        
        .form-control-af.border-end-0 {
            border-left: none;
        }
        .form-control-af.border-end-0:focus {
            box-shadow: none;
            border-color: var(--color-border); /* custom handling for groups */
        }
    </style>
</head>
<body>
    
    <div class="login-card">
        <div class="text-center mb-4">
            <div class="login-brand-icon">
                <i class="bi bi-gem"></i>
            </div>
            <h1 class="h3 fw-bold mb-1" style="color: var(--color-primary);">AFRAWY STORE</h1>
            <h2 class="h6 text-muted fw-normal" style="letter-spacing: 0.5px;">متجر الأدوات والدهانات</h2>
            <hr class="w-25 mx-auto border-secondary mt-3 mb-4">
        </div>

        <form action="/Dashboard" method="get">
            <div class="mb-4">
                <label for="username" class="form-label">اسم المستخدم</label>
                <div class="input-group" style="height: 44px;">
                    <span class="input-group-text border rounded-start border-end-0 bg-white pe-3" style="border-color: var(--color-border);"><i class="bi bi-person"></i></span>
                    <input type="text" class="form-control form-control-af border-start-0 rounded-end" id="username" placeholder="مثال: ahmed123" required autofocus />
                </div>
            </div>

            <div class="mb-4">
                <label for="password" class="form-label">كلمة المرور</label>
                <div class="input-group" style="height: 44px;">
                    <span class="input-group-text border rounded-start border-end-0 bg-white pe-3" style="border-color: var(--color-border);"><i class="bi bi-lock"></i></span>
                    <input type="password" class="form-control form-control-af border-start-0 rounded-0" id="password" placeholder="••••••••" required />
                    <button class="btn border border-start-0 rounded-end bg-white text-muted px-3" type="button" tabindex="-1" style="border-color: var(--color-border);"><i class="bi bi-eye"></i></button>
                </div>
            </div>

            <div class="d-flex justify-content-between align-items-center mb-5">
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" id="rememberMe">
                    <label class="form-check-label fs-sm text-muted" for="rememberMe" style="margin-right: -4px;">
                        تذكرني
                    </label>
                </div>
                <a href="#" class="fs-sm text-decoration-none">نسيت كلمة المرور؟</a>
            </div>

            <!-- Login button goes straight to Dashboard right now for mockup -->
            <button type="submit" class="btn btn-primary-af w-100 py-3 fs-6 d-flex justify-content-center align-items-center gap-2 shadow-sm rounded">
                تسجيل الدخول <i class="bi bi-box-arrow-in-left"></i>
            </button>
        </form>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
