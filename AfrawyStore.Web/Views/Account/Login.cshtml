@model AfrawyStore.Application.DTOs.LoginDto
@{
    Layout = null;
    ViewData["Title"] = "تسجيل الدخول";
}
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>تسجيل الدخول —El-Afrawy Store</title>
    <link rel="stylesheet" href="~/css/bootstrap.rtl.min.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
        :root {
            --primary: #6366f1;
            --primary-dark: #4f46e5;
            --primary-glow: rgba(99,102,241,0.25);
        }

        body {
            font-family: 'Cairo', sans-serif;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            background: #0f172a;
            overflow: hidden;
            position: relative;
        }

        /* Animated mesh gradient background */
        .bg-mesh {
            position: fixed;
            inset: 0;
            z-index: 0;
            background:
                radial-gradient(ellipse 80% 60% at 20% 20%, rgba(99,102,241,0.25) 0%, transparent 60%),
                radial-gradient(ellipse 60% 50% at 80% 80%, rgba(79,46,229,0.2) 0%, transparent 60%),
                radial-gradient(ellipse 70% 70% at 50% 50%, rgba(15,23,42,1) 0%, transparent 100%);
            animation: mesh-shift 12s ease-in-out infinite alternate;
        }

        @@keyframes mesh-shift {
            0%   { filter: hue-rotate(0deg)   brightness(1); }
            100% { filter: hue-rotate(20deg)  brightness(1.08); }
        }

        /* Floating orbs */
        .orb {
            position: fixed;
            border-radius: 50%;
            filter: blur(80px);
            opacity: 0.18;
            animation: orb-float 8s ease-in-out infinite alternate;
            z-index: 0;
        }
        .orb-1 { width: 400px; height: 400px; background: #6366f1; top: -100px; right: -100px; animation-delay: 0s; }
        .orb-2 { width: 300px; height: 300px; background: #818cf8; bottom: -80px; left: -80px; animation-delay: 3s; }
        .orb-3 { width: 200px; height: 200px; background: #a78bfa; top: 50%; left: 20%; animation-delay: 6s; }

        @@keyframes orb-float {
            0%   { transform: translate(0, 0) scale(1); }
            100% { transform: translate(20px, 20px) scale(1.08); }
        }

        /* Grid lines */
        .bg-grid {
            position: fixed;
            inset: 0;
            z-index: 0;
            background-image:
                linear-gradient(rgba(255,255,255,0.03) 1px, transparent 1px),
                linear-gradient(90deg, rgba(255,255,255,0.03) 1px, transparent 1px);
            background-size: 60px 60px;
        }

        /* Login card */
        .login-wrapper {
            position: relative;
            z-index: 10;
            width: 100%;
            max-width: 440px;
            padding: 16px;
        }

        .login-card {
            background: rgba(255,255,255,0.04);
            backdrop-filter: blur(24px);
            -webkit-backdrop-filter: blur(24px);
            border: 1px solid rgba(255,255,255,0.1);
            border-radius: 24px;
            padding: 44px 40px;
            box-shadow:
                0 32px 80px rgba(0,0,0,0.5),
                inset 0 1px 0 rgba(255,255,255,0.1);
            animation: card-in 0.5s cubic-bezier(0.34,1.56,0.64,1) forwards;
            opacity: 0;
        }

        @@keyframes card-in {
            0%   { opacity: 0; transform: translateY(32px) scale(0.96); }
            100% { opacity: 1; transform: translateY(0) scale(1); }
        }

        /* Brand icon */
        .brand-orb {
            width: 72px;
            height: 72px;
            background: linear-gradient(135deg, #818cf8, #6366f1, #4f46e5);
            border-radius: 20px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.8rem;
            color: white;
            margin: 0 auto 20px;
            box-shadow: 0 8px 32px rgba(99,102,241,0.5), 0 0 0 1px rgba(255,255,255,0.1);
            animation: brand-in 0.6s cubic-bezier(0.34,1.56,0.64,1) 0.2s both;
        }

        @@keyframes brand-in {
            0%   { opacity: 0; transform: scale(0.5) rotate(-10deg); }
            100% { opacity: 1; transform: scale(1) rotate(0); }
        }

        .login-title {
            color: white;
            font-size: 1.5rem;
            font-weight: 800;
            letter-spacing: -0.03em;
            margin-bottom: 4px;
        }

        .login-subtitle {
            color: rgba(255,255,255,0.45);
            font-size: 0.875rem;
            font-weight: 400;
        }

        /* Form inputs */
        .login-label {
            display: block;
            font-size: 0.75rem;
            font-weight: 700;
            letter-spacing: 0.06em;
            text-transform: uppercase;
            color: rgba(255,255,255,0.55);
            margin-bottom: 8px;
        }

        .login-input-wrap {
            position: relative;
        }

        .login-input-icon {
            position: absolute;
            top: 50%;
            right: 14px;
            transform: translateY(-50%);
            color: rgba(255,255,255,0.3);
            font-size: 1rem;
            pointer-events: none;
            transition: color 0.2s;
        }

        .login-input {
            width: 100%;
            height: 48px;
            padding: 0 44px 0 14px;
            background: rgba(255,255,255,0.06);
            border: 1.5px solid rgba(255,255,255,0.1);
            border-radius: 12px;
            color: white;
            font-family: 'Cairo', sans-serif;
            font-size: 0.95rem;
            transition: all 0.2s;
        }

        .login-input::placeholder { color: rgba(255,255,255,0.25); }

        .login-input:focus {
            outline: none;
            border-color: rgba(99,102,241,0.7);
            background: rgba(99,102,241,0.1);
            box-shadow: 0 0 0 3px rgba(99,102,241,0.2);
        }

        .login-input:focus + .login-input-icon,
        .login-input-wrap:focus-within .login-input-icon {
            color: rgba(99,102,241,0.8);
        }

        .show-pass-btn {
            position: absolute;
            top: 50%;
            left: 14px;
            transform: translateY(-50%);
            background: none;
            border: none;
            color: rgba(255,255,255,0.3);
            cursor: pointer;
            padding: 4px;
            font-size: 1rem;
            transition: color 0.2s;
        }

        .show-pass-btn:hover { color: rgba(255,255,255,0.7); }

        /* Submit button */
        .login-btn {
            width: 100%;
            height: 50px;
            background: linear-gradient(135deg, #818cf8, #6366f1, #4f46e5);
            border: none;
            border-radius: 12px;
            color: white;
            font-family: 'Cairo', sans-serif;
            font-size: 1rem;
            font-weight: 700;
            cursor: pointer;
            transition: all 0.2s;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            box-shadow: 0 8px 24px rgba(99,102,241,0.4);
            position: relative;
            overflow: hidden;
        }

        .login-btn::before {
            content: '';
            position: absolute;
            top: 0; left: -100%;
            width: 100%; height: 100%;
            background: linear-gradient(90deg, transparent, rgba(255,255,255,0.15), transparent);
            transition: left 0.5s;
        }

        .login-btn:hover::before { left: 100%; }
        .login-btn:hover { transform: translateY(-2px); box-shadow: 0 12px 32px rgba(99,102,241,0.5); }
        .login-btn:active { transform: translateY(0); }

        /* Validation */
        .text-danger { color: #f87171 !important; font-size: 0.8rem; margin-top: 6px; display: block; }

        /* Divider */
        .login-divider {
            height: 1px;
            background: rgba(255,255,255,0.08);
            margin: 28px 0;
        }

        /* Remember me */
        .form-check-input {
            background-color: rgba(255,255,255,0.1);
            border-color: rgba(255,255,255,0.2);
        }

        .form-check-input:checked {
            background-color: #6366f1;
            border-color: #6366f1;
        }

        .form-check-label {
            color: rgba(255,255,255,0.5);
            font-size: 0.85rem;
        }

        .forgot-link {
            color: rgba(99,102,241,0.8);
            font-size: 0.85rem;
            text-decoration: none;
            transition: color 0.2s;
        }

        .forgot-link:hover { color: #818cf8; }
    </style>
</head>
<body>
    <div class="bg-mesh"></div>
    <div class="bg-grid"></div>
    <div class="orb orb-1"></div>
    <div class="orb orb-2"></div>
    <div class="orb orb-3"></div>

    <div class="login-wrapper">
        <div class="login-card">

            <!-- Brand -->
            <div class="text-center mb-5">
                <div class="brand-orb">
                    <i class="bi bi-gem"></i>
                </div>
                <h1 class="login-title">AFRAWY STORE</h1>
                <p class="login-subtitle">متجر الأدوات والدهانات — نظام الإدارة الداخلي</p>
            </div>

            <!-- Form -->
            <form asp-controller="Account" asp-action="Login" asp-route-returnurl="@ViewData["ReturnUrl"]" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="mb-4">
                    <label class="login-label">اسم المستخدم</label>
                    <div class="login-input-wrap">
                        <input asp-for="Username" class="login-input" placeholder="أدخل اسم المستخدم" required autofocus autocomplete="username" />
                        <i class="bi bi-person login-input-icon"></i>
                    </div>
                    <span asp-validation-for="Username" class="text-danger"></span>
                </div>

                <div class="mb-4">
                    <label class="login-label">كلمة المرور</label>
                    <div class="login-input-wrap">
                        <input asp-for="Password" type="password" id="passwordInput" class="login-input" placeholder="••••••••" required autocomplete="current-password" style="padding-left:44px;" />
                        <i class="bi bi-lock login-input-icon"></i>
                        <button type="button" class="show-pass-btn" id="togglePass">
                            <i class="bi bi-eye" id="toggleIcon"></i>
                        </button>
                    </div>
                    <span asp-validation-for="Password" class="text-danger"></span>
                </div>

                <div class="login-divider"></div>

                <div class="d-flex justify-content-between align-items-center mb-5">
                    <div class="form-check mb-0">
                        <input asp-for="RememberMe" class="form-check-input" id="rememberMe">
                        <label class="form-check-label" for="rememberMe">تذكرني</label>
                    </div>
                    <a href="#" class="forgot-link">نسيت كلمة المرور؟</a>
                </div>

                <button type="submit" class="login-btn">
                    <span>تسجيل الدخول</span>
                    <i class="bi bi-arrow-left-circle"></i>
                </button>
            </form>
        </div>

        <p class="text-center mt-4" style="color:rgba(255,255,255,0.2);font-size:.75rem;">
            AFRAWY STORE v1.1 &nbsp;·&nbsp; للاستخدام الداخلي فقط
        </p>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        document.getElementById('togglePass').addEventListener('click', function () {
            const inp  = document.getElementById('passwordInput');
            const icon = document.getElementById('toggleIcon');
            if (inp.type === 'password') {
                inp.type = 'text';
                icon.className = 'bi bi-eye-slash';
            } else {
                inp.type = 'password';
                icon.className = 'bi bi-eye';
            }
        });
    </script>
</body>
</html>
