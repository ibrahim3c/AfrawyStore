@model IEnumerable<AfrawyStore.Application.DTOs.SaleDto>
@{
    ViewData["Title"] = "المبيعات";
    var currentPage = (int)(ViewBag.CurrentPage ?? 1);
    var totalPages = (int)(ViewBag.TotalPages ?? 1);
    var totalCount = (int)(ViewBag.TotalCount ?? 0);
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="h3 text-primary mb-0"><i class="bi bi-cart3 me-2"></i> @ViewData["Title"]</h2>
    <a asp-action="New" class="btn btn-accent shadow-sm px-4">
        <i class="bi bi-plus-circle me-1"></i> بيع جديد
    </a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
        <i class="bi bi-check-circle me-2"></i> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
        <i class="bi bi-exclamation-triangle me-2"></i> @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- Filters -->
<div class="card shadow-sm border-0 rounded-4 mb-4">
    <div class="card-body py-3">
        <form method="get" class="row g-3 align-items-end">
            <div class="col-md-3">
                <label class="form-label small text-muted">بحث (رقم الفاتورة)</label>
                <input type="text" name="searchTerm" class="form-control form-control-af" placeholder="رقم الفاتورة..." value="@ViewBag.SearchTerm" />
            </div>
            <div class="col-md-2">
                <label class="form-label small text-muted">من تاريخ</label>
                <input type="date" name="dateFrom" class="form-control form-control-af" value="@ViewBag.DateFrom" />
            </div>
            <div class="col-md-2">
                <label class="form-label small text-muted">إلى تاريخ</label>
                <input type="date" name="dateTo" class="form-control form-control-af" value="@ViewBag.DateTo" />
            </div>
            <div class="col-md-2">
                <label class="form-label small text-muted">الحالة</label>
                <select name="status" class="form-select form-control-af">
                    <option value="">الكل</option>
                    <option value="completed" selected="@(ViewBag.Status == "completed")">مكتملة</option>
                    <option value="voided" selected="@(ViewBag.Status == "voided")">ملغاة</option>
                </select>
            </div>
            <div class="col-md-3 d-flex gap-2">
                <button type="submit" class="btn btn-primary-af flex-grow-1">
                    <i class="bi bi-funnel me-1"></i> تصفية
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-counterclockwise"></i>
                </a>
            </div>
        </form>
    </div>
</div>

<!-- Summary -->
<div class="d-flex justify-content-between align-items-center mb-3">
    <span class="text-muted small">إجمالي النتائج: <strong class="text-dark">@totalCount</strong></span>
</div>

<!-- Sales Table -->
<div class="card shadow-sm border-0 rounded-4">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4" style="width: 80px;">#</th>
                        <th>التاريخ</th>
                        <th class="text-center">عدد الأصناف</th>
                        <th class="text-center">الخصم</th>
                        <th class="text-center">الإجمالي</th>
                        <th class="text-center">طريقة الدفع</th>
                        <th class="text-center">الحالة</th>
                        <th>الكاشير</th>
                        <th class="text-end pe-4">الإجراءات</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var sale in Model)
                    {
                        <tr class="@(sale.Status == AfrawyStore.Domain.Enums.SaleStatus.Voided ? "table-danger" : "")">
                            <td class="ps-4">
                                <span class="badge bg-light text-dark border font-monospace">#@sale.Id</span>
                            </td>
                            <td class="text-muted small">@sale.SaleDate.ToString("yyyy/MM/dd hh:mm tt")</td>
                            <td class="text-center">
                                <span class="badge bg-primary bg-opacity-10 text-primary">@sale.ItemCount صنف</span>
                            </td>
                            <td class="text-center">
                                @if (sale.Discount > 0)
                                {
                                    <span class="text-danger numeric fw-semibold">-@sale.Discount.ToString("N2") ج</span>
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                            </td>
                            <td class="text-center fw-bold numeric text-dark">@sale.TotalAmount.ToString("N2") ج</td>
                            <td class="text-center">
                                @{
                                    var payIcon = sale.PaymentMethod == AfrawyStore.Domain.Enums.PaymentMethod.Cash ? "bi-cash" :
                                                  sale.PaymentMethod == AfrawyStore.Domain.Enums.PaymentMethod.Card ? "bi-credit-card" : "bi-wallet2";
                                }
                                <span class="badge bg-light text-dark border">
                                    <i class="bi @payIcon me-1"></i>@sale.PaymentMethodLabel
                                </span>
                            </td>
                            <td class="text-center">
                                @if (sale.Status == AfrawyStore.Domain.Enums.SaleStatus.Completed)
                                {
                                    <span class="badge bg-success bg-opacity-10 text-success border border-success-subtle px-2 py-1">
                                        <i class="bi bi-check-circle-fill me-1"></i>@sale.StatusLabel
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-danger bg-opacity-10 text-danger border border-danger-subtle px-2 py-1">
                                        <i class="bi bi-x-octagon-fill me-1"></i>@sale.StatusLabel
                                    </span>
                                }
                            </td>
                            <td class="text-muted small">@sale.CreatedByName</td>
                            <td class="text-end pe-4">
                                <a asp-action="Detail" asp-route-id="@sale.Id" class="btn btn-sm btn-outline-primary shadow-sm" title="تفاصيل">
                                    <i class="bi bi-receipt me-1"></i> عرض
                                </a>
                            </td>
                        </tr>
                    }
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="9" class="text-center py-5 text-muted">
                                <i class="bi bi-inbox fs-2 d-block mb-2 text-black-50"></i>
                                لا توجد عمليات بيع
                                <div class="mt-3">
                                    <a asp-action="New" class="btn btn-accent btn-sm"><i class="bi bi-plus-circle me-1"></i> بيع جديد</a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Pagination -->
@if (totalPages > 1)
{
    <nav class="mt-4 d-flex justify-content-center">
        <ul class="pagination pagination-sm">
            <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                <a class="page-link" asp-action="Index" asp-route-page="@(currentPage - 1)"
                   asp-route-searchTerm="@ViewBag.SearchTerm" asp-route-dateFrom="@ViewBag.DateFrom"
                   asp-route-dateTo="@ViewBag.DateTo" asp-route-status="@ViewBag.Status">
                    <i class="bi bi-chevron-right"></i>
                </a>
            </li>
            @for (int i = 1; i <= totalPages; i++)
            {
                <li class="page-item @(i == currentPage ? "active" : "")">
                    <a class="page-link" asp-action="Index" asp-route-page="@i"
                       asp-route-searchTerm="@ViewBag.SearchTerm" asp-route-dateFrom="@ViewBag.DateFrom"
                       asp-route-dateTo="@ViewBag.DateTo" asp-route-status="@ViewBag.Status">@i</a>
                </li>
            }
            <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                <a class="page-link" asp-action="Index" asp-route-page="@(currentPage + 1)"
                   asp-route-searchTerm="@ViewBag.SearchTerm" asp-route-dateFrom="@ViewBag.DateFrom"
                   asp-route-dateTo="@ViewBag.DateTo" asp-route-status="@ViewBag.Status">
                    <i class="bi bi-chevron-left"></i>
                </a>
            </li>
        </ul>
    </nav>
}
